<header class="header-container">
  <h1>{{title}}</h1>
  <form class="clear-filters" action="/beaches" method="GET">
    <button class="btn-solid" id="search-button"type="submit">Clear Filters</button>
  </form>
</header>

<div class="filter-bar">
  <form class="filter-field" action="/beaches" method="GET">
    <label for="search">Name:</label>
    <input type="text" id="name" name="name" value="{{searchQuery}}" placeholder="Search by name">

    <label for="county">County:</label>
    <input type="text" id="county" name="county" placeholder="Search by county">

    <label for="city">City:</label>
    <input type="text" id="city" name="city" placeholder="Search by city">
    <button class="btn-solid" id="search-button"type="submit">Search</button>
  </form>
</div>
<div class="filter-bar">
  <form class="filter-field" action="/beaches" method="GET">
    <label for="waterQuality">Min Water Quality:</label>
    <select type="number" id="waterQuality" name="waterQuality" min="0" max="10" step="1" placeholder="10">
        <option value="">Any</option>
        <option value="10">10</option>
        <option value="9">9</option>
        <option value="8">8</option>
        <option value="7">7</option>
        <option value="6">6</option>
        <option value="5">5</option>
        <option value="4">4</option>
        <option value="3">3</option>
        <option value="2">2</option>
        <option value="1">1</option>
    </select>

    <label for="minLength">Min Length (Miles):</label>
    <select id="minLength" name="minLength">
      <option value="">Any</option>
      <option value="<1"><1</option>
      <option value="1">1</option>
      <option value="2">2</option>
    </select>

    <label for="maxLength">Max Length (Miles):</label>
    <select id="maxLength" name="maxLength">
      <option value="">Any</option>
      <option value="1">1</option>
      <option value="2">2</option>
      <option value="3">3</option>
      <option value="4">4</option>
      <option value="5">5</option>
      <option value="6">6</option>
    </select>

    <label for="minUserRating">Min User Rating:</label>
    <select type="number" id="minUserRating" name="minUserRating" placeholder ="5">
      <option value="">Any</option>
      <option value="0">0</option>
      <option value="1">1</option>
      <option value="2">2</option>
      <option value="3">3</option>
      <option value="4">4</option>
      <option value="5">5</option>
    </select>

    <label for="minAutoRating">Min Auto Rating:</label>
    <select type="number" id="minAutoRating" name="minAutoRating">
      <option value="">Any</option>
      <option value="1">1</option>
      <option value="2">2</option>
      <option value="3">3</option>
      <option value="4">4</option>
      <option value="5">5</option>
    </select>

    <label for="maxAutoRating">Max Auto Rating:</label>
    <select type="number" id="maxAutoRating" name="maxAutoRating">
      <option value="">Any</option>
      <option value="1">1</option>
      <option value="2">2</option>
      <option value="3">3</option>
      <option value="4">4</option>
      <option value="5">5</option>
    </select>

    <button class="btn-solid" id="filter-button" type="submit">Apply Filters</button>
  </form>
</div>

<div class="search-results">
  <header>
    {{#if searchQuery}}
      <h2>Search Results for "{{searchQuery}}"</h2>
    {{else}}
      <h2>All Beaches</h2>
    {{/if}}
  </header>

  

{{#if beaches.length}}
  <ol class="results-list">
    {{#each beaches}}
      <li class="search-result">
        <!-- Left Side: Image, Name, Location -->
        <div class="result-left">
          <a href="/beaches/{{this._id}}" class="image-wrapper">
            <img class="searchResultImage" alt="{{this.beachName}}" src="/images/beachStockImage.jpg">
          </a>
          <h3 class="searchResult-name">{{this.beachName}}</h3>
          <div class="beach-location">{{this.city}}, {{this.county}}</div>
        </div>

        <!-- Right Side: Details -->
        <div class="result-right">
          <div class="beach-length"><strong>Beach Length:</strong> {{this.beachLength}} miles</div>
          <div class="water-quality quality-{{this.waterQuality}}">
            <strong>Water Quality:</strong> {{#if this.waterQuality}}{{this.waterQuality}}{{else}}Not rated{{/if}}
          </div>
          <div class="user-rating"><strong>User Rating:</strong> {{#if this.userRating}}{{this.userRating}}{{else}}N/A{{/if}}</div>
          <div class="auto-rating"><strong>Auto Rating:</strong> {{#if this.autoRating}}{{this.autoRating}} / 5{{else}}N/A{{/if}}</div>
          <div class="bookmark-status">
            <strong>{{#if this.isBookmarked}}Bookmarked{{else}}Not Bookmarked{{/if}}</strong> 
          </div>
        </div>
      </li>
    {{/each}}
  </ol>
  {{else}}
    <p>No beaches matched your search.</p>
  {{/if}}
</div>