<section class="page-head">
  <div>
    <h1>{{title}}</h1>
    <p class="page-sub">See what's happening on the sand, or host your own event.</p>
  </div>
  <a class="btn-solid" href="/community/create">Host an Event</a>
</section>

<section class="activity-feed">
  <div class="profile-section">
    <div class="profile-section-head">
      <h2>Recent Reviews</h2>
      <span class="section-count">{{recentReviews.length}}</span>
    </div>
    {{#if recentReviews.length}}
      <ul class="review-list">
        {{#each recentReviews}}
          <li class="review-item">
            <div class="review-head">
              <a class="review-beach" href="/beaches/{{this.beachId}}">{{this.beachName}}</a>
              {{#if this.rating}}<span class="beach-rating">&#9733; {{this.rating}}/5</span>{{/if}}
            </div>
            {{#if this.comment}}<p class="review-body">&ldquo;{{this.comment}}&rdquo;</p>{{/if}}
            <p class="review-time">{{this.name}}{{#if this.when}} &middot; {{this.when}}{{/if}}</p>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="page-sub">No reviews yet. <a href="/beaches">Explore beaches</a> and be the first to leave one.</p>
    {{/if}}
  </div>

  <div class="profile-section">
    <div class="profile-section-head">
      <h2>Active Advisories</h2>
      <span class="section-count">{{activeAdvisories.length}}</span>
    </div>
    {{#if activeAdvisories.length}}
      <ul class="mini-list">
        {{#each activeAdvisories}}
          <li class="mini-item">
            <div class="advisory-head">
              <span class="advisory-badge">{{this.advisoryType}}</span>
              {{#if this.beachName}}
                <a class="mini-title" href="/beaches/{{this.beachId}}">{{this.beachName}}</a>
              {{else}}
                <span class="mini-title">A beach in the area</span>
              {{/if}}
            </div>
            <span class="mini-meta">{{#if this.advisoryCause}}{{this.advisoryCause}} &middot; {{/if}}Since {{this.startDate}}</span>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="page-sub">No active advisories right now &mdash; clear skies!</p>
    {{/if}}
  </div>
</section>

<form id="event-filters" class="filter-bar" method="GET" action="/community">
  <div class="filter-field">
    <label for="filter-date">Date</label>
    <input type="date" id="filter-date" name="date" data-current="{{filters.date}}" />
  </div>

  <div class="filter-field">
    <label for="filter-startTime">Start time</label>
    <input type="text" id="filter-startTime" name="startTime" value="{{filters.startTime}}" placeholder="e.g. 2:00PM" />
  </div>

  <div class="filter-field">
    <label for="filter-type">Event type</label>
    <select id="filter-type" name="type" data-selected="{{filters.type}}">
      <option value="">All types</option>
      <option value="Meet up">Meet up</option>
      <option value="Beach Cleanup">Beach Cleanup</option>
      <option value="Pinic">Picnic</option>
      <option value="Barbeque">Barbeque</option>
      <option value="Contest">Contest</option>
      <option value="Fishing">Fishing</option>
      <option value="Swimming">Swimming</option>
      <option value="Volleyball">Volleyball</option>
      <option value="Frisbee">Frisbee</option>
      <option value="Football">Football</option>
      <option value="Other">Other</option>
    </select>
  </div>

  <div class="filter-field filter-field-narrow">
    <label for="filter-minAttendance">Min. attendees</label>
    <input type="number" id="filter-minAttendance" name="minAttendance" value="{{filters.minAttendance}}" min="0" />
  </div>

  <div class="filter-actions">
    <button class="btn-solid" type="submit">Apply</button>
    <a class="filter-clear" href="/community">Clear</a>
  </div>
</form>

{{#if events.length}}
  <ul class="event-grid">
    {{#each events}}
      <li class="event-card">
        <div class="event-card-top">
          <span class="event-chip">{{this.eventType}}</span>
          <span class="event-count">{{this.attendants.length}} going</span>
        </div>
        <h2 class="event-card-title"><a href="/community/{{this._id}}">{{this.eventName}}</a></h2>
        <p class="event-meta">{{this.eventDate}} &middot; {{this.startTime}}&ndash;{{this.endTime}}</p>
        <p class="event-meta">Meet at: {{this.meetingLocation}}</p>
        <p class="event-card-foot">{{this.EventComments.length}} comments</p>
      </li>
    {{/each}}
  </ul>
{{else}}
  <div class="empty-state">
    <p class="empty-title">No events found.</p>
    <p class="page-sub">Try clearing the filters, or be the first to host one.</p>
    <a class="btn-solid" href="/community/create">Host an Event</a>
  </div>
{{/if}}

<script src="/js/community.js" defer></script>
